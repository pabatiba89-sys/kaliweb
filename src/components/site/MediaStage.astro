---
import { showcaseMedia } from '../../site/showcase.js';
import { translateText } from '../../site/localization.js';
const { locale, mediaKey = 'overview', position = 'center', eager = false } = Astro.props;
const t = (value: string) => translateText(value, locale);
const media = showcaseMedia[mediaKey as keyof typeof showcaseMedia] || showcaseMedia.overview;
---
<figure class:list={['media-stage', `media-stage--${position}`, { 'has-video': Boolean(media.src) }]}>
  {media.src ? (
    <video controls playsinline preload="metadata" poster={media.poster} aria-label={t('Watch the video')}>
      <source src={media.src} type={media.type} />
      {media.captions.map((track: { src: string; lang: string; label: string }) => <track kind="captions" src={track.src} srclang={track.lang} label={track.label} default={track.lang === locale} />)}
      <a href={media.src}>{t('Download')}</a>
    </video>
  ) : (
    <img src={media.poster} width="1536" height="1024" alt={t('Creative studio illustration')} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  )}
  <figcaption>{t(media.src ? 'Watch the video' : 'Creative studio illustration')}</figcaption>
</figure>
