---
import PublicLayout from '../../layouts/PublicLayout.astro';
import WorkflowDemo from '../../components/site/WorkflowDemo.astro';
import MediaStage from '../../components/site/MediaStage.astro';
import PracticalSections from '../../components/site/PracticalSections.astro';
import type { PracticalSection } from '../../site/content-types';
import { homeByLocale } from '../../site/home.js';
import { pagesByLocale, pagePath, supportedLocales } from '../../site/content.js';
import { translateText, brandName } from '../../site/localization.js';
import { productScenes, showcaseMedia } from '../../site/showcase.js';
import { getSeoMetadata } from '../../site/seo.js';

export function getStaticPaths() {
  return supportedLocales.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const home = homeByLocale[lang] as {
  eyebrow: string; headline: string; lead: string; proof: string[];
  sectionTitle: string; sectionLead: string; title: string; description: string;
  primaryCta?: string; primaryHref?: string; overviewTitle?: string;
  closingTitle?: string; closingCta?: string; practicalSections?: PracticalSection[];
};
const seo = getSeoMetadata(lang, '', home);
const t = (value: string) => translateText(value, lang);
type ProductPage = { slug: string; eyebrow: string; headline: string; description: string };
const products = (pagesByLocale[lang] as ProductPage[]).filter((page) => Object.hasOwn(productScenes, page.slug));
const schema = {
  '@type': 'SoftwareApplication', name: brandName(lang), applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web', url: new URL(pagePath(lang), Astro.site), description: seo.description,
  screenshot: new URL('/previews/workspace.webp', Astro.site),
  ...(seo.keywords.length > 0 ? { keywords: seo.keywords.join(', ') } : {}),
  publisher: { '@id': `${Astro.site}#organization` },
};
---
<PublicLayout locale={lang} title={seo.title} description={seo.description} keywords={seo.keywords} schema={schema} pageClass="showcase-home">
  <section class="showcase-hero section-wrap">
    <div class="hero-copy"><p class="eyebrow">{home.eyebrow}</p><h1>{home.headline}</h1><p class="hero-lead">{home.lead}</p><div class="hero-actions"><a class="primary-cta" href={home.primaryHref || '/app/'}>{home.primaryCta || t('Open the workspace')} <span>↗</span></a><a class="text-cta" href="#workflow-demo">{t('See the production flow')} <span>↓</span></a></div></div>
    <MediaStage locale={lang} eager={true} />
  </section>
  <section class="studio-overview section-wrap">
    <div class="overview-copy"><p class="eyebrow">{t('CONTENT PIPELINE')}</p><h2>{home.overviewTitle || t('Turn today’s idea into a finished video')}</h2><ul>{home.proof.map((proof) => <li>{proof}</li>)}</ul></div>
    <figure class="workspace-capture"><div class="capture-bar"><span class="mini-brand">K</span><span>{t('Workspace preview')}</span><a href="/app/" aria-label={t('Open the workspace')}>↗</a></div><img src="/previews/workspace.webp" width="1440" height="960" alt={`${brandName(lang)} — ${t('Workspace preview')}`} loading="lazy" /></figure>
  </section>
  <PracticalSections locale={lang} sections={home.practicalSections} />
  <WorkflowDemo locale={lang} />
  <section class="product-section">
    <div class="section-heading"><p class="eyebrow">{t('CONNECTED STUDIOS')}</p><h2>{home.sectionTitle}</h2><p>{home.sectionLead}</p></div>
    <div class="product-grid">
      {products.map((product) => {
        const scene = productScenes[product.slug as keyof typeof productScenes];
        return <article class="product-card"><a class={`product-card__image product-card__image--${scene.position}`} href={pagePath(lang, product.slug)} tabindex="-1" aria-hidden="true"><img src={showcaseMedia[product.slug as keyof typeof showcaseMedia].poster} width="1536" height="1024" alt="" loading="lazy" /></a><div class="product-card__copy"><p class="eyebrow">{product.eyebrow}</p><h3>{product.headline}</h3><p>{product.description}</p><a href={pagePath(lang, product.slug)}>{t('Explore')} {t(scene.label)} <span>→</span></a></div></article>;
      })}
    </div>
  </section>
  <section class="closing-cta"><p class="eyebrow">{t('READY FOR YOUR NEXT IDEA')}</p><h2>{home.closingTitle || t('Build once. Create for every market.')}</h2><a class="primary-cta" href={home.primaryHref || '/app/'}>{home.closingCta || t('Create with Kali')} <span>↗</span></a></section>
</PublicLayout>
