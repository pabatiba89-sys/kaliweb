---
import WorkspaceApp from '../main.jsx';
import '../styles.css';
import { localeMeta, supportedLocales } from '../site/localization.js';
import { getWorkspaceContent } from '../site/workspace-content.js';
import { workspacePath, workspacePagesForLocale } from '../workspaceRoutes.js';
import { GOOGLE_SITE_VERIFICATION } from '../site/site-config.js';
const { locale = 'en', page = 'home' } = Astro.props;
const copy = localeMeta[locale];
const content = getWorkspaceContent(locale, page);
const canonical = new URL(workspacePath(locale, page), Astro.site);
const alternates = supportedLocales.filter((code) => workspacePagesForLocale(code).some((entry) => entry.id === page));
const defaultLocale = alternates.includes('en') ? 'en' : alternates[0];
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebApplication', name: content.title, description: content.description, url: canonical, applicationCategory: 'MultimediaApplication', operatingSystem: 'Web', inLanguage: copy.hreflang },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: content.home, item: new URL(`/${locale}/`, Astro.site) },
    { '@type': 'ListItem', position: 2, name: content.workspace, item: new URL(workspacePath(locale), Astro.site) },
    ...(page === 'home' ? [] : [{ '@type': 'ListItem', position: 3, name: content.label, item: canonical }]),
  ] },
] };
---
<!doctype html>
<html lang={copy.hreflang} dir={copy.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{content.title}</title>
    <meta name="description" content={content.description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    <link rel="canonical" href={canonical} />
    {alternates.map((code) => <link rel="alternate" hreflang={localeMeta[code].hreflang} href={new URL(workspacePath(code, page), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(workspacePath(defaultLocale, page), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={content.title} />
    <meta property="og:description" content={content.description} />
    <meta property="og:url" content={canonical} />
    <script is:inline src="/invite-attribution.js"></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <WorkspaceApp client:only="react" />
    <section class="workspace-guide" aria-label={content.workspace}>
      <div class="workspace-guide__header">
        <h1>{content.label}</h1>
        <nav class="workspace-guide__quick-links"><a href={`/${locale}/`}>{content.home}</a><a href={`/${locale}/help/`}>{content.help}</a></nav>
      </div>
      <details class="workspace-guide__group">
        <summary>{content.workspace}</summary>
        <div class="workspace-guide__panel">
          <p>{content.summary}</p>
          <nav class="workspace-guide__grid" aria-label={content.workspace}>{content.pages.map((entry) => <a href={entry.path} aria-current={entry.id === page ? 'page' : undefined}>{entry.label}</a>)}</nav>
        </div>
      </details>
      <details class="workspace-guide__group">
        <summary>{copy.label}</summary>
        <nav class="workspace-guide__grid workspace-guide__panel" aria-label="Languages">{supportedLocales.map((code) => <a href={workspacePath(code, workspacePagesForLocale(code).some((entry) => entry.id === page) ? page : 'home')} lang={localeMeta[code].hreflang} dir={localeMeta[code].dir} aria-current={code === locale ? 'page' : undefined}>{localeMeta[code].label}</a>)}</nav>
      </details>
    </section>
  </body>
</html>
<style>
  .workspace-guide { margin-block: 0 24px; margin-inline: 302px 26px; padding: 14px 18px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 24px; border: 1px solid var(--line); border-radius: 14px; color: var(--muted); background: var(--paper); font-size: 12px; line-height: 1.6; }
  :global(body:has(.main-shell.is-expanded)) .workspace-guide { margin-inline-start: 120px; }
  .workspace-guide__header { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block-end: 8px; }
  .workspace-guide h1 { margin: 0; font-size: 12px; font-weight: 650; color: var(--muted); }
  .workspace-guide a { color: var(--green); text-decoration: none; overflow-wrap: anywhere; }
  .workspace-guide a:hover { text-decoration: underline; }
  .workspace-guide a:focus-visible, .workspace-guide summary:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; border-radius: 4px; }
  .workspace-guide__quick-links { display: flex; gap: 16px; flex-wrap: wrap; }
  .workspace-guide__group { min-width: 0; border-top: 1px solid var(--line); }
  .workspace-guide summary { padding-block: 8px; cursor: pointer; width: fit-content; color: var(--ink); }
  .workspace-guide__panel { padding-block: 4px 10px; }
  .workspace-guide__panel p { margin: 0 0 12px; max-width: 65ch; }
  .workspace-guide__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 6px 14px; }
  .workspace-guide__grid a { padding-block: 4px; }
  .workspace-guide__grid a[aria-current="page"] { font-weight: 700; color: var(--ink); }
  @media (max-width: 920px) {
    .workspace-guide, :global(body:has(.main-shell.is-expanded)) .workspace-guide { margin-inline: 18px; }
  }
  @media (max-width: 640px) {
    .workspace-guide, :global(body:has(.main-shell.is-expanded)) .workspace-guide { margin-inline: 12px; padding: 12px 14px; grid-template-columns: minmax(0, 1fr); }
    .workspace-guide__header { align-items: flex-start; flex-wrap: wrap; }
  }
</style>
